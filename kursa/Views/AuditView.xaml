<UserControl x:Class="kursa.Views.AuditView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><Button Style="{StaticResource BaseButton}" DockPanel.Dock="Right" Content="Проверить файл" Click="Verify_Click" HorizontalAlignment="Right" Margin="0"/>
            <StackPanel><TextBlock Text="Журнал действий" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Только чтение · события SQL всех клиентов; проверяется файл текущего профиля Windows и базы" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel>
        </DockPanel>
        <Border x:Name="StatusCard" Grid.Row="1" Style="{StaticResource PanelCard}" Padding="12" Margin="0,0,0,12"><StackPanel>
            <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Файл: " Style="{StaticResource CaptionText}" Margin="0,7,0,2"/>
            <TextBox x:Name="PathBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"/>
            <TextBlock Text="Сверка обнаруживает расхождение, но не устанавливает автора. Одновременная подмена файла и SQL-эталона может остаться незамеченной." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource PanelCard}" Margin="0,0,0,12" Padding="12,8"><Expander x:Name="FiltersExpander" Header="Фильтры" IsExpanded="False">
            <WrapPanel Margin="0,12,0,2"><StackPanel Style="{StaticResource FilterField}" Width="320"><TextBlock Text="Поиск в последних 1000 событиях SQL" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SearchBox" KeyDown="Search_KeyDown"/></StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10"><Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/><Button Style="{StaticResource BaseButton}" Content="Сбросить" Click="Reset_Click"/></StackPanel>
            </WrapPanel>
        </Expander></Border>
        <DataGrid x:Name="GridView" Grid.Row="3" SelectionChanged="Grid_SelectionChanged" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
            <DataGridTextColumn Header="№ SQL" Binding="{Binding Id}" Width="75"/><DataGridTextColumn Header="Время местное" Binding="{Binding LocalTime, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="150"/>
            <DataGridTextColumn Header="Логин" Binding="{Binding ActorLogin}" Width="130"/><DataGridTextColumn Header="Пользователь" Binding="{Binding ActorName}" Width="170"/>
            <DataGridTextColumn Header="Роль на момент действия" Binding="{Binding ActorRole}" Width="165"/><DataGridTextColumn Header="Действие в программе" Binding="{Binding Action}" Width="210"/>
            <DataGridTextColumn Header="Объект" Binding="{Binding Entity}" Width="155"/><DataGridTextColumn Header="ID объекта" Binding="{Binding EntityId}" Width="100"/>
            <DataGridTextColumn Header="Поток файла" Binding="{Binding StreamId}" Width="240"/>
        </DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="4" Margin="0,9,0,0"><TextBlock x:Name="CountText" Style="{StaticResource CaptionText}"/>
            <TextBlock Text="Подробности выбранного события (значения до и после):" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <TextBox x:Name="DetailsBox" IsReadOnly="True" Height="115" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </Grid>
</UserControl>
