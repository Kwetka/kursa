<Window Language="ru-BY" x:Class="kursa.Views.Dialogs.PasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Сменить пароль" Width="480" Height="390"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Смена пароля приложения" Style="{StaticResource TitleText}"/>
        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="Текущий пароль" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="CurrentBox"/>
            <TextBlock Text="Новый пароль" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><PasswordBox x:Name="NewBox"/>
            <TextBlock Text="Повторите новый пароль" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><PasswordBox x:Name="ConfirmBox"/>
            <TextBlock Text="Не менее 8 символов." Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource BaseButton}" Content="Отмена" IsCancel="True"/><Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0"/></StackPanel>
    </Grid>
</Window>
