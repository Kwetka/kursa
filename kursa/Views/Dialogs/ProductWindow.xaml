<Window Language="ru-BY" x:Class="kursa.Views.Dialogs.ProductWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Товар" Width="500" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Style="{StaticResource TitleText}"/>
        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="Наименование" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" MaxLength="200"/>
            <TextBlock Text="Единица измерения" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><TextBox x:Name="UnitBox" MaxLength="30"/>
            <TextBlock Text="Закупочная цена, BYN" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><TextBox x:Name="PurchaseBox"/>
            <TextBlock Text="Продажная цена, BYN" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><TextBox x:Name="SaleBox"/>
            <TextBlock Text="Обе цены обязательны и должны быть больше нуля. Не более двух знаков после запятой; валюта — BYN." Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource BaseButton}" Content="Отмена" IsCancel="True"/><Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
