<Window Language="ru-BY" x:Class="kursa.Views.Dialogs.TtnPrintWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ТТН · предварительный просмотр" Width="1250" Height="860" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="18,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PrintButton" Content="Печать…" Style="{StaticResource PrimaryButton}" Click="Print_Click"/>
                    <Button Content="Закрыть" Style="{StaticResource BaseButton}" Click="Close_Click" Margin="0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="Heading" Style="{StaticResource TitleText}" FontSize="18"/>
                    <TextBlock x:Name="WarningText" Style="{StaticResource CaptionText}" Foreground="#9D2525" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <FlowDocumentScrollViewer x:Name="Viewer" Grid.Row="1" Background="#E9EDF3" Padding="16" VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
