<Window Language="ru-BY" x:Class="kursa.Views.Dialogs.DocumentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Складской документ" Width="1280" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="SubHeading" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource PanelCard}" Padding="15,12,15,4">
                    <WrapPanel>
                        <StackPanel x:Name="FromPanel" Style="{StaticResource FilterField}" Width="230"><TextBlock Text="Склад-отправитель" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="FromBox" DisplayMemberPath="Name" SelectionChanged="FromBox_Changed"/></StackPanel>
                        <StackPanel x:Name="ToPanel" Style="{StaticResource FilterField}" Width="230"><TextBlock Text="Склад-получатель" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ToBox" DisplayMemberPath="Name" SelectionChanged="ToBox_Changed"/></StackPanel>
                        <StackPanel x:Name="PartyPanel" Style="{StaticResource FilterField}" Width="280"><TextBlock x:Name="PartyLabel" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="PartyBox" DisplayMemberPath="Name" SelectionChanged="PartyBox_Changed"/></StackPanel>
                        <StackPanel Style="{StaticResource FilterField}" Width="170"><TextBlock x:Name="NumberLabel" Text="Номер ТТН" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NumberBox" MaxLength="30" ToolTip="Серия и номер бланка ТТН, например АА 1234567. Можно оставить пустым."/></StackPanel>
                        <StackPanel x:Name="DatePanel" Style="{StaticResource FilterField}" Width="170"><TextBlock Text="Дата накладной поставщика" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DocumentDatePicker"/></StackPanel>
                    </WrapPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0" Padding="15,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Товары" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AvailabilityHint" Style="{StaticResource CaptionText}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <StackPanel Style="{StaticResource FilterField}" Width="360"><TextBlock Text="Товар (начните вводить название)" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ProductBox" DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
                            <StackPanel Style="{StaticResource FilterField}" Width="120"><TextBlock Text="Количество" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="QuantityBox" Text="1" KeyDown="QuantityBox_KeyDown"/></StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                <Button x:Name="AddLineButton" Content="+ Добавить в документ" Style="{StaticResource PrimaryButton}" Click="AddLine_Click"/>
                                <Button x:Name="RemoveLineButton" Content="Удалить строку" Style="{StaticResource DangerButton}" Click="RemoveLine_Click"/>
                            </StackPanel>
                        </WrapPanel>
                        <DataGrid x:Name="LinesGrid" Height="290" IsReadOnly="False" SelectionUnit="CellOrRowHeader" HorizontalScrollBarVisibility="Auto"
                                  CellEditEnding="LinesGrid_CellEditEnding">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShort}" Value="True"><Setter Property="Background" Value="#FFF0EE"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding Number}" IsReadOnly="True" Width="42"/>
                                <DataGridTextColumn Header="Наименование" Binding="{Binding ProductName}" IsReadOnly="True" Width="220"/>
                                <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" IsReadOnly="True" Width="50"/>
                                <DataGridTextColumn x:Name="AvailableColumn" Header="В наличии" Binding="{Binding AvailableDisplay}" IsReadOnly="True" Width="90"/>
                                <DataGridTextColumn Header="Количество ✎" Binding="{Binding QuantityText}" Width="100"/>
                                <DataGridTextColumn Header="Цена без НДС ✎" Binding="{Binding PriceText}" Width="115"/>
                                <DataGridTextColumn x:Name="DiscountColumn" Header="Скидка, % ✎" Binding="{Binding DiscountText}" Width="95"/>
                                <DataGridTextColumn x:Name="VatRateColumn" Header="НДС, % ✎" Binding="{Binding VatText}" Width="80"/>
                                <DataGridTextColumn Header="Стоимость" Binding="{Binding AmountDisplay}" IsReadOnly="True" Width="100"/>
                                <DataGridTextColumn x:Name="VatAmountColumn" Header="Сумма НДС" Binding="{Binding VatAmountDisplay}" IsReadOnly="True" Width="95"/>
                                <DataGridTextColumn x:Name="TotalColumn" Header="С НДС" Binding="{Binding AmountWithVatDisplay}" IsReadOnly="True" Width="105"/>
                                <DataGridTextColumn Header="Груз. мест ✎" Binding="{Binding PlacesText}" Width="95"/>
                                <DataGridTextColumn Header="Масса, кг ✎" Binding="{Binding MassText}" Width="95"/>
                                <DataGridTextColumn Header="Примечание ✎" Binding="{Binding Note}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="TotalsText" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="✎ — ячейку можно изменить двойным щелчком или вводом с клавиатуры. Цены — без НДС; НДС начисляется сверху. Красным выделены строки, где количество больше остатка." Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0" Padding="15,10">
                    <Expander x:Name="TtnExpander" Header="Реквизиты ТТН: транспорт, заказчик перевозки, основание, пункты погрузки и разгрузки">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Автомобиль (марка, гос. номер)" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="VehicleBox" IsEditable="True"/>
                                <TextBlock Text="Прицеп (марка, гос. номер)" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><ComboBox x:Name="TrailerBox" IsEditable="True"/>
                                <TextBlock Text="Водитель (ФИО)" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><ComboBox x:Name="DriverBox" IsEditable="True"/>
                                <TextBlock Text="К путевому листу №" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><TextBox x:Name="WaybillBox" MaxLength="50"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Заказчик перевозки (плательщик)" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PayerBox" IsEditable="True"/>
                                <TextBlock Text="УНП заказчика перевозки" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><TextBox x:Name="PayerUnpBox" MaxLength="9"/>
                                <TextBlock Text="Основание отпуска (договор, счёт)" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><TextBox x:Name="BasisBox" MaxLength="300"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Заказчик — покупатель" Style="{StaticResource BaseButton}" Height="28" Click="PayerBuyer_Click" x:Name="PayerBuyerButton"/>
                                    <Button Content="Заказчик — моя организация" Style="{StaticResource BaseButton}" Height="28" Click="PayerOrganization_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Пункт погрузки" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LoadingBox" MaxLength="400"/>
                                <TextBlock Text="Пункт разгрузки" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><TextBox x:Name="UnloadingBox" MaxLength="400"/>
                                <TextBlock Text="Отпуск разрешил (должность, ФИО)" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><TextBox x:Name="ReleaseBox" MaxLength="200"/>
                                <TextBlock Text="Сдал грузоотправитель (должность, ФИО)" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/><TextBox x:Name="HandedBox" MaxLength="200"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Border>

                <TextBlock Text="Комментарий к документу" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/><TextBox x:Name="CommentBox" MaxLength="500"/>
                <TextBlock x:Name="OrganizationHint" Style="{StaticResource CaptionText}" Foreground="#9D2525" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource BaseButton}" Content="Отмена" IsCancel="True"/>
                <Button x:Name="SavePrintButton" Content="Провести и печатать ТТН" Style="{StaticResource BaseButton}" Click="SavePrint_Click"/>
                <Button x:Name="SaveButton" Content="Провести" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0"/>
            </StackPanel>
            <TextBlock Text="Документ проводится целиком в одной транзакции: если хотя бы одной позиции не хватает на складе, не проводится ничего." Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
