<Window Language="ru-BY" x:Class="kursa.Views.Dialogs.OperationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Складская операция" Width="1090" Height="780" MinWidth="850" MinHeight="610" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Все позиции проводятся одной операцией. Дата и время проведения назначаются SQL Server." Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
        </StackPanel>
        <TabControl x:Name="OperationTabs" Grid.Row="1" Margin="0,16,0,0">
            <TabItem Header="Товары и маршрут">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <StackPanel x:Name="FromPanel" Width="225" Margin="0,0,12,10"><TextBlock Text="Со склада" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="FromBox" DisplayMemberPath="Name" SelectionChanged="From_Changed"/></StackPanel>
                        <StackPanel x:Name="ToPanel" Width="225" Margin="0,0,12,10"><TextBlock Text="На склад" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ToBox" DisplayMemberPath="Name"/></StackPanel>
                        <StackPanel x:Name="PartyPanel" Width="260" Margin="0,0,12,10"><TextBlock x:Name="PartyLabel" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PartyBox" DisplayMemberPath="Name" SelectionChanged="Party_Changed"/></StackPanel>
                    </WrapPanel>
                    <DockPanel Grid.Row="1" Margin="0,4,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="AddItemButton" Content="+ Товар" Style="{StaticResource PrimaryButton}" Click="AddItem_Click"/>
                            <Button Content="Изменить" Style="{StaticResource BaseButton}" Click="EditItem_Click"/>
                            <Button Content="Удалить" Style="{StaticResource DangerButton}" Click="DeleteItem_Click" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="Позиции операции" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid x:Name="ItemsGrid" Grid.Row="2" HorizontalScrollBarVisibility="Auto" MouseDoubleClick="EditItem_Click">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="240"/><DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100"/>
                            <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="60"/><DataGridTextColumn x:Name="PriceColumn" Header="Цена до скидки, BYN" Binding="{Binding Price}" Width="155"/>
                            <DataGridTextColumn x:Name="DiscountColumn" Header="Скидка" Binding="{Binding Discount}" Width="90"/><DataGridTextColumn x:Name="VatColumn" Header="НДС" Binding="{Binding Vat}" Width="90"/>
                            <DataGridTextColumn x:Name="PlacesColumn" Header="Мест" Binding="{Binding Places}" Width="80"/><DataGridTextColumn x:Name="MassColumn" Header="Масса, т" Binding="{Binding Mass}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="Комментарий к операции" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CommentBox" MaxLength="500"/>
                        <TextBlock Text="Для добавления позиции нажмите «+ Товар». В списке можно выбрать несколько товаров." Style="{StaticResource CaptionText}" Margin="0,5,0,0"/></StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="InvoiceTab" Header="Накладная ТТН">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <TextBlock Text="Реквизиты накладной" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Реквизиты организации и контрагентов задаёт администратор. Менеджер продаж выбирает их из справочника; неизвестные транспортные поля останутся пустыми." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                        <WrapPanel>
                            <StackPanel Width="170" Margin="0,0,12,12"><TextBlock Text="Серия · при наличии" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SeriesBox" MaxLength="30"/></StackPanel>
                            <StackPanel Width="160" Margin="0,0,12,12"><TextBlock Text="Номер" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NumberBox" MaxLength="50"/></StackPanel>
                            <StackPanel Width="200" Margin="0,0,12,12"><TextBlock Text="Дата накладной" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="InvoiceDate"/></StackPanel>
                            <StackPanel Width="300" Margin="0,0,12,12"><TextBlock Text="Цена и НДС" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PriceModeBox" SelectionChanged="PriceMode_Changed"><ComboBoxItem Content="Цена включает НДС"/><ComboBoxItem Content="НДС начисляется к цене"/><ComboBoxItem Content="Без НДС"/></ComboBox></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Выберите режим для каждой реализации. Режим «Без НДС» очищает ставки у товаров и услуги." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <CheckBox x:Name="AutoNumberBox" Content="Автоматический внутренний номер (снимите флажок для своего номера)" Click="AutoNumber_Click" Margin="0,0,0,6"/>
                        <TextBlock Text="Автономер — внутренний и не является номером защищённого бланка. DOCX — проект, а не защищённый бланк ТТН-1." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="Грузоотправитель · реквизиты организации" FontWeight="SemiBold" Margin="0,6,0,5"/>
                        <WrapPanel>
                            <StackPanel Width="300" Margin="0,0,12,10"><TextBlock Text="Наименование" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SenderNameBox" IsReadOnly="True"/></StackPanel>
                            <StackPanel Width="340" Margin="0,0,12,10"><TextBlock Text="Адрес" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SenderAddressBox" IsReadOnly="True"/></StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,10"><TextBlock Text="УНП" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SenderUnpBox" IsReadOnly="True"/></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Грузополучатель" FontWeight="SemiBold" Margin="0,8,0,5"/>
                        <StackPanel Width="420" HorizontalAlignment="Left" Margin="0,0,0,10"><TextBlock Text="Контрагент · по умолчанию покупатель" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RecipientPartyBox" SelectionChanged="RecipientParty_Changed"/></StackPanel>
                        <WrapPanel>
                            <StackPanel Width="300" Margin="0,0,12,10"><TextBlock Text="Наименование" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RecipientNameBox" MaxLength="200"/></StackPanel>
                            <StackPanel Width="340" Margin="0,0,12,10"><TextBlock Text="Адрес" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RecipientAddressBox" MaxLength="400"/></StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,10"><TextBlock Text="УНП · при наличии" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RecipientUnpBox" MaxLength="30"/></StackPanel>
                        </WrapPanel>
                        <DockPanel Margin="0,8,0,5"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PayerRecipientButton" Content="Как получатель" Style="{StaticResource BaseButton}" Click="PayerRecipient_Click"/><Button Content="Как отправитель" Style="{StaticResource BaseButton}" Click="PayerSender_Click"/><Button Content="Очистить" Style="{StaticResource BaseButton}" Click="PayerClear_Click"/></StackPanel><TextBlock Text="Заказчик перевозки / плательщик" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                        <StackPanel Width="420" HorizontalAlignment="Left" Margin="0,0,0,10"><TextBlock Text="Или выберите контрагента из справочника" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PayerPartyBox" SelectionChanged="PayerParty_Changed"/></StackPanel>
                        <WrapPanel>
                            <StackPanel Width="300" Margin="0,0,12,10"><TextBlock Text="Наименование" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PayerNameBox" MaxLength="200"/></StackPanel>
                            <StackPanel Width="340" Margin="0,0,12,10"><TextBlock Text="Адрес" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PayerAddressBox" MaxLength="400"/></StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,10"><TextBlock Text="УНП · при наличии" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PayerUnpBox" MaxLength="30"/></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Основание и перевозка" FontWeight="SemiBold" Margin="0,8,0,5"/>
                        <WrapPanel>
                            <StackPanel Width="260" Margin="0,0,12,10"><TextBlock Text="Основание отпуска · вид" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BasisNameBox" MaxLength="200"/></StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,10"><TextBlock Text="Номер основания" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BasisNumberBox" MaxLength="100"/></StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,10"><TextBlock Text="Дата основания" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="BasisDate"/></StackPanel>
                            <StackPanel Width="250" Margin="0,0,12,10"><TextBlock Text="Путевой лист №" Style="{StaticResource FieldLabel}"/><TextBox x:Name="WaybillBox" MaxLength="100"/></StackPanel>
                            <StackPanel Width="300" Margin="0,0,12,10"><TextBlock Text="Пункт погрузки · адрес" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LoadingBox" MaxLength="400"/></StackPanel>
                            <StackPanel Width="300" Margin="0,0,12,10"><TextBlock Text="Пункт разгрузки · адрес" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UnloadingBox" MaxLength="400"/></StackPanel>
                            <StackPanel Width="250" Margin="0,0,12,10"><TextBlock Text="Водитель · фамилия и инициалы" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DriverBox" MaxLength="200"/></StackPanel>
                            <StackPanel Width="300" Margin="0,0,12,10"><TextBlock Text="Автомобиль · марка и госномер" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VehicleBox" MaxLength="200"/></StackPanel>
                            <StackPanel Width="300" Margin="0,0,12,10"><TextBlock Text="Прицеп · марка и госномер" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TrailerBox" MaxLength="200"/></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Транспортные услуги · отдельная строка, остатки не изменяются" FontWeight="SemiBold" Margin="0,8,0,5"/>
                        <WrapPanel>
                            <StackPanel Width="220" Margin="0,0,12,10"><TextBlock Text="Стоимость, BYN · необязательно" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TransportPriceBox"/></StackPanel>
                            <StackPanel Width="260" Margin="0,0,12,10"><TextBlock Text="Ставка НДС, % · пусто — без НДС" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TransportVatBox"/></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="После проведения накладная сохраняется в SQL и автоматически создаётся в DOCX. Проверьте все реквизиты перед использованием." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource BaseButton}" Content="Отмена" IsCancel="True"/><Button x:Name="SaveButton" Content="Провести" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
