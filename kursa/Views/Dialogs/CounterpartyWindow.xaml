<Window Language="ru-BY" x:Class="kursa.Views.Dialogs.CounterpartyWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Контрагент" Width="560" Height="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Style="{StaticResource TitleText}"/>
        <ScrollViewer Grid.Row="1" Margin="0,22,0,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Наименование (как в ТТН)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" MaxLength="200"/>
                <TextBlock Text="Тип контрагента" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                <ComboBox x:Name="TypeBox"><ComboBoxItem x:Name="SupplierItem" Content="Поставщик"/><ComboBoxItem x:Name="BuyerItem" Content="Покупатель"/></ComboBox>
                <TextBlock x:Name="TypeHint" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="Реквизиты для ТТН" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <TextBlock Text="УНП (9 символов)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UnpBox" MaxLength="9"/>
                <TextBlock Text="Юридический адрес" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><TextBox x:Name="AddressBox" MaxLength="400"/>
                <TextBlock Text="Адрес разгрузки (если отличается от юридического)" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><TextBox x:Name="DeliveryBox" MaxLength="400"/>
                <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><TextBox x:Name="PhoneBox" MaxLength="100"/>
                <TextBlock Text="Договор — основание отпуска по умолчанию" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><TextBox x:Name="ContractBox" MaxLength="200"/>
                <TextBlock Text="Например: «Договор № 12 от 10.01.2026». Подставляется в документ, при необходимости меняется в нём." Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource BaseButton}" Content="Отмена" IsCancel="True"/><Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
