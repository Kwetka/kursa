<Window Language="ru-BY" x:Class="kursa.Views.Dialogs.OperationItemWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товарная позиция" Width="610" Height="780" MinHeight="550" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="25">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Товарная позиция" Style="{StaticResource TitleText}"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="Товар" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ProductBox" DisplayMemberPath="Name" SelectionChanged="Product_Changed"/>
                <TextBlock Text="Количество · до трёх знаков" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/><TextBox x:Name="QuantityBox" Text="1" TextChanged="Quantity_Changed"/>
                <TextBlock x:Name="UnitText" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
                <StackPanel x:Name="SalePanel">
                    <TextBlock Text="Цена до скидки, BYN" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/><TextBox x:Name="PriceBox"/>
                    <TextBlock Text="Скидка, % · от 0 до менее 100" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/><TextBox x:Name="DiscountBox" Text="0"/>
                    <TextBlock Text="Ставка НДС, % · пусто означает «без НДС»" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/><TextBox x:Name="VatBox"/>
                    <TextBlock Text="До четырёх знаков; 0 % и «без НДС» различаются." Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Width="245" Margin="0,0,12,0"><TextBlock Text="Количество грузовых мест" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PlacesBox" TextChanged="Cargo_Changed"/></StackPanel>
                        <StackPanel Width="245"><TextBlock Text="Масса груза, т" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MassBox" TextChanged="Cargo_Changed"/></StackPanel>
                    </WrapPanel>
                    <Button Content="Подставить массу и места по карточке" Style="{StaticResource BaseButton}" Click="CalculateCargo_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    <TextBlock Text="Если в карточке нет данных, поля остаются пустыми. Фактические значения можно ввести вручную." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <TextBlock Text="Примечание к строке" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/><TextBox x:Name="NoteBox" MaxLength="500"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource BaseButton}" Content="Отмена" IsCancel="True"/><Button x:Name="ItemSaveButton" Style="{StaticResource PrimaryButton}" Content="Добавить / сохранить" Click="Save_Click" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
