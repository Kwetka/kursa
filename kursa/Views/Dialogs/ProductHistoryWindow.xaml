<Window Language="ru-BY" x:Class="kursa.Views.Dialogs.ProductHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="История товара" Width="1250" Height="760" MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="SubHeading" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,12,0,12" Padding="15,12,15,2">
            <WrapPanel>
                <StackPanel Style="{StaticResource FilterField}" Width="160"><TextBlock Text="С даты" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="FromPicker"/></StackPanel>
                <StackPanel Style="{StaticResource FilterField}" Width="160"><TextBlock Text="По дату включительно" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="ToPicker"/></StackPanel>
                <StackPanel Style="{StaticResource FilterField}" Width="170"><TextBlock Text="Тип операции" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="KindBox"/></StackPanel>
                <StackPanel Style="{StaticResource FilterField}" Width="200"><TextBlock Text="Склад · откуда или куда" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="WarehouseBox"/></StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button x:Name="ApplyButton" Content="Показать" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
                    <Button Content="Сбросить" Style="{StaticResource BaseButton}" Click="Reset_Click"/>
                </StackPanel>
            </WrapPanel>
        </Border>
        <DataGrid x:Name="GridView" Grid.Row="2" HorizontalScrollBarVisibility="Auto" MouseDoubleClick="Open_Click">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата и время" Binding="{Binding OccurredAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="145"/>
                <DataGridTextColumn Header="Операция" Binding="{Binding KindName}" Width="115"/>
                <DataGridTextColumn Header="" Binding="{Binding Direction}" Width="30"/>
                <DataGridTextColumn Header="Документ" Binding="{Binding DocumentNumberDisplay}" Width="150"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity, StringFormat={}{0:N3}}" Width="105"/>
                <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="50"/>
                <DataGridTextColumn Header="Цена без НДС" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="105"/>
                <DataGridTextColumn Header="Со склада" Binding="{Binding FromWarehouse}" Width="140"/>
                <DataGridTextColumn Header="На склад" Binding="{Binding ToWarehouse}" Width="140"/>
                <DataGridTextColumn Header="Контрагент" Binding="{Binding CounterpartyName}" Width="160"/>
                <DataGridTextColumn Header="Примечание" Binding="{Binding Comment}" Width="170"/>
                <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="SummaryText" Grid.Row="3" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OpenButton" Content="Открыть документ" Style="{StaticResource PrimaryButton}" Click="Open_Click"/>
                <Button Content="Закрыть" Style="{StaticResource BaseButton}" IsCancel="True" Click="Close_Click" Margin="0"/>
            </StackPanel>
            <TextBlock Text="Двойной щелчок по строке открывает документ со всеми позициями." Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
