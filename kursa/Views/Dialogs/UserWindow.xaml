<Window Language="ru-BY" x:Class="kursa.Views.Dialogs.UserWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Учётная запись" Width="520" Height="590"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Style="{StaticResource TitleText}"/>
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="Логин" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LoginBox" MaxLength="80"/>
            <TextBlock Text="ФИО" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/><TextBox x:Name="NameBox" MaxLength="200"/>
            <TextBlock Text="Роль" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/><ComboBox x:Name="RoleBox"/>
            <TextBlock x:Name="PasswordLabel" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/><PasswordBox x:Name="PasswordBox" MaxLength="200"/>
            <TextBlock Text="Повторите новый пароль" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/><PasswordBox x:Name="ConfirmBox" MaxLength="200"/>
            <TextBlock Text="Пароль: от 8 до 200 символов. При редактировании оставьте оба поля пустыми, чтобы не менять пароль." Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource BaseButton}" Content="Отмена" IsCancel="True"/><Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0"/></StackPanel>
    </Grid>
</Window>
