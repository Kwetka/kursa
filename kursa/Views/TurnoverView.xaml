<UserControl x:Class="kursa.Views.TurnoverView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock Text="Анализ оборачиваемости" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Выберите позиции, склад и период; расчёт основан на истории всех движений" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelCard}" Padding="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="ТОВАРЫ ДЛЯ РАСЧЁТА" FontWeight="Bold" FontSize="12" Foreground="#475569"/>
                    <TextBox x:Name="ProductSearch" Grid.Row="1" Margin="0,10,0,8" TextChanged="Search_Changed" ToolTip="Поиск в списке товаров"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8"><Button Style="{StaticResource BaseButton}" Content="Выбрать видимые" Click="SelectVisible_Click" Padding="8,3" MinWidth="0"/><Button Style="{StaticResource BaseButton}" Content="Снять видимые" Click="ClearVisible_Click" Padding="8,3" MinWidth="0" Margin="0"/></StackPanel>
                    <ListBox x:Name="ProductList" Grid.Row="3" BorderBrush="#E1E7EF" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Product.Name}" IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="6,5"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="SelectionText" Grid.Row="4" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                </Grid>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource PanelCard}" Padding="15,12,15,3" Margin="0,0,0,12">
                    <WrapPanel>
                        <StackPanel Style="{StaticResource FilterField}" Width="215"><TextBlock Text="С · дата / ЧЧ:ММ" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="FromPicker" Width="145" SelectedDateChanged="Filter_Changed"/><TextBox x:Name="FromTimeBox" Width="62" Margin="5,0,0,0" TextChanged="Time_Changed" ToolTip="Время ЧЧ:ММ, необязательно"/></StackPanel></StackPanel>
                        <StackPanel Style="{StaticResource FilterField}" Width="215"><TextBlock Text="По · дата / ЧЧ:ММ включительно" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="ToPicker" Width="145" SelectedDateChanged="Filter_Changed"/><TextBox x:Name="ToTimeBox" Width="62" Margin="5,0,0,0" TextChanged="Time_Changed" ToolTip="Время ЧЧ:ММ, необязательно"/></StackPanel></StackPanel>
                        <StackPanel Style="{StaticResource FilterField}" Width="200"><TextBlock Text="Склад" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="WarehouseBox" SelectionChanged="Filter_Changed"/></StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10"><Button Content="Рассчитать" Style="{StaticResource PrimaryButton}" Click="Calculate_Click"/><Button Style="{StaticResource BaseButton}" Content="Сбросить" Click="Reset_Click"/></StackPanel>
                    </WrapPanel>
                </Border>
                <TextBlock x:Name="PeriodText" Grid.Row="1" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,9" Text="Отметьте товары и нажмите «Рассчитать»."/>
                <DataGrid x:Name="GridView" Grid.Row="2" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="200"/>
                        <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="60"/>
                        <DataGridTextColumn Header="Средний запас" Binding="{Binding AverageStock, StringFormat={}{0:N3}}" Width="130"/>
                        <DataGridTextColumn Header="Отгружено" Binding="{Binding Sold, StringFormat={}{0:N3}}" Width="115"/>
                        <DataGridTextColumn Header="Коэффициент" Binding="{Binding CoefficientDisplay}" Width="120"/>
                        <DataGridTextColumn Header="Дней на оборот" Binding="{Binding DaysDisplay}" Width="135"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="3" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0"
                    Text="Средний запас взвешивается по времени между операциями; коэффициент = отгрузки / средний запас. Дней = длительность периода / коэффициент. Время ЧЧ:ММ необязательно; для сегодняшней даты расчёт ограничен текущим временем сервера."/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
