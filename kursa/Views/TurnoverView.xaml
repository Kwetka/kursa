<UserControl x:Class="kursa.Views.TurnoverView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock Text="Анализ оборачиваемости" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Выберите позиции, склад и период; расчёт основан на истории всех движений" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="12,8" Margin="0,0,0,12">
            <Expander x:Name="FiltersExpander" Header="Фильтры" IsExpanded="False">
                <Grid Margin="0,12,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ТОВАРЫ ДЛЯ РАСЧЁТА" FontWeight="Bold" FontSize="12" Foreground="#475569"/>
                        <TextBox x:Name="ProductSearch" Margin="0,8,0,8" TextChanged="Search_Changed" ToolTip="Поиск в списке товаров; отметки сохраняются"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Style="{StaticResource BaseButton}" Content="Выбрать видимые" Click="SelectVisible_Click" Padding="8,3" MinWidth="0"/><Button Style="{StaticResource BaseButton}" Content="Снять видимые" Click="ClearVisible_Click" Padding="8,3" MinWidth="0" Margin="0"/></StackPanel>
                        <ListBox x:Name="ProductList" Height="150" BorderBrush="#E1E7EF" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Product.Name}" IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="6,5"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="SelectionText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="2">
                        <StackPanel Style="{StaticResource FilterField}" Width="215"><TextBlock Text="С · дата / ЧЧ:ММ" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="FromPicker" Width="145"/><TextBox x:Name="FromTimeBox" Width="62" Margin="5,0,0,0" ToolTip="Время ЧЧ:ММ, необязательно"/></StackPanel></StackPanel>
                        <StackPanel Style="{StaticResource FilterField}" Width="215"><TextBlock Text="По · дата / ЧЧ:ММ включительно" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="ToPicker" Width="145"/><TextBox x:Name="ToTimeBox" Width="62" Margin="5,0,0,0" ToolTip="Время ЧЧ:ММ, необязательно"/></StackPanel></StackPanel>
                        <StackPanel Style="{StaticResource FilterField}" Width="200"><TextBlock Text="Склад" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="WarehouseBox"/></StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10"><Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Click="Calculate_Click"/><Button Style="{StaticResource BaseButton}" Content="Сбросить" Click="Reset_Click"/></StackPanel>
                    </WrapPanel>
                </Grid>
            </Expander>
        </Border>
        <TextBlock x:Name="PeriodText" Grid.Row="2" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,9" Text="Откройте фильтры, отметьте товары и нажмите «Применить»."/>
        <DataGrid x:Name="GridView" Grid.Row="3" HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="200"/>
                <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="60"/>
                <DataGridTextColumn Header="Средний запас" Binding="{Binding AverageStock, StringFormat={}{0:N3}}" Width="130"/>
                <DataGridTextColumn Header="Отгружено" Binding="{Binding Sold, StringFormat={}{0:N3}}" Width="115"/>
                <DataGridTextColumn Header="Коэффициент" Binding="{Binding CoefficientDisplay}" Width="120"/>
                <DataGridTextColumn Header="Дней на оборот" Binding="{Binding DaysDisplay}" Width="135"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="4" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0"
            Text="Средний запас взвешивается по времени между операциями; коэффициент = отгрузки / средний запас. Дней = длительность периода / коэффициент. Время ЧЧ:ММ необязательно; для сегодняшней даты расчёт ограничен текущим временем сервера."/>
    </Grid>
</UserControl>
