<Window Language="ru-BY" x:Class="kursa.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Склад · Управление запасами" Width="1450" Height="900"
        MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#10213B" Padding="20,13">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center"><TextBlock x:Name="UserText" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="RoleText" Foreground="#A8BED8" FontSize="11" HorizontalAlignment="Right"/></StackPanel>
                    <Button x:Name="OrganizationButton" Style="{StaticResource BaseButton}" Content="Моя организация" Click="Organization_Click" ToolTip="Реквизиты организации для ТТН (изменяет администратор)"/><Button Style="{StaticResource BaseButton}" Content="Сменить пароль" Click="Password_Click"/><Button Style="{StaticResource BaseButton}" Content="Выход из учётной записи" Click="Logout_Click" Margin="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1769D2" CornerRadius="6" Width="40" Height="40" Margin="0,0,12,0"><TextBlock Text="С" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel><TextBlock Text="СКЛАД" Foreground="White" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="Управление запасами и аналитика" Foreground="#A8BED8" FontSize="11"/></StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="10,8,10,0">
            <Border x:Name="AuditWarning" Background="#FFF0EE" BorderBrush="#D58A83" BorderThickness="1" CornerRadius="4" Padding="10,6" Visibility="Collapsed" Margin="0,0,0,4"><DockPanel>
                <Button DockPanel.Dock="Right" Content="Журнал" Style="{StaticResource BaseButton}" Click="Audit_Click" Margin="8,0,0,0"/>
                <TextBlock x:Name="AuditWarningText" Foreground="#9D2525" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel></Border>
            <Border x:Name="OrganizationWarning" Background="#EEF5FF" BorderBrush="#9CBDE8" BorderThickness="1" CornerRadius="4" Padding="10,6" Visibility="Collapsed" Margin="0,0,0,4"><DockPanel>
                <Button x:Name="OrganizationWarningButton" DockPanel.Dock="Right" Content="Заполнить" Style="{StaticResource BaseButton}" Click="Organization_Click" Margin="8,0,0,0"/>
                <TextBlock x:Name="OrganizationWarningText" Foreground="#23446E" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel></Border>
            <Border x:Name="LegacyWarning" Background="#FFF8E5" BorderBrush="#E6CD8B" BorderThickness="1" CornerRadius="4" Padding="10,6" Visibility="Collapsed"><TextBlock x:Name="LegacyWarningText" Foreground="#775600" TextWrapping="Wrap"/></Border>
        </StackPanel>
        <TabControl x:Name="Tabs" Grid.Row="2" Margin="10,10,10,0" SelectionChanged="Tabs_SelectionChanged">
            <TabItem x:Name="ProductsTab" Header="Номенклатура"><ContentControl x:Name="ProductsHost"/></TabItem>
            <TabItem x:Name="WarehousesTab" Header="Склады"><ContentControl x:Name="WarehousesHost"/></TabItem>
            <TabItem x:Name="CounterpartiesTab" Header="Контрагенты"><ContentControl x:Name="CounterpartiesHost"/></TabItem>
            <TabItem x:Name="OperationsTab" Header="Операции"><ContentControl x:Name="OperationsHost"/></TabItem>
            <TabItem x:Name="StocksTab" Header="Остатки"><ContentControl x:Name="StocksHost"/></TabItem>
            <TabItem x:Name="TurnoverTab" Header="Оборачиваемость"><ContentControl x:Name="TurnoverHost"/></TabItem>
            <TabItem x:Name="ReportsTab" Header="Отчёты и диаграммы"><ContentControl x:Name="ReportsHost"/></TabItem>
            <TabItem x:Name="UsersTab" Header="Пользователи"><ContentControl x:Name="UsersHost"/></TabItem>
            <TabItem x:Name="AuditTab" Header="Журнал действий"><ContentControl x:Name="AuditHost"/></TabItem>
        </TabControl>
        <Border Grid.Row="3" Background="#EDF1F6" Padding="20,7"><DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="Валюта: BYN · время операций: SQL Server" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
            <TextBlock x:Name="AuditFooter" Text="SQL Server подключён · журнал не проверен" Style="{StaticResource CaptionText}"/>
        </DockPanel></Border>
    </Grid>
</Window>
