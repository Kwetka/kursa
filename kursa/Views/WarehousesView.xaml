<UserControl x:Class="kursa.Views.WarehousesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel x:Name="ActionsPanel" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="+ Добавить" Style="{StaticResource PrimaryButton}" Click="Add_Click"/><Button Style="{StaticResource BaseButton}" Content="Изменить" Click="Edit_Click"/>
                <Button Content="Удалить" Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="0"/>
            </StackPanel>
            <StackPanel><TextBlock Text="Склады" Style="{StaticResource TitleText}"/><TextBlock Text="Адреса, заведующие и их контакты" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,0,0,12" Padding="12,8">
            <Expander x:Name="FiltersExpander" Header="Фильтры" IsExpanded="False">
                <WrapPanel Margin="0,12,0,2">
                    <StackPanel Style="{StaticResource FilterField}" Width="310"><TextBlock Text="Поиск" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SearchBox" Width="310" ToolTip="Название, адрес, заведующий или контакт" KeyDown="Search_KeyDown"/></StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10"><Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/><Button Style="{StaticResource BaseButton}" Content="Сбросить" Click="Reset_Click"/></StackPanel>
                </WrapPanel>
            </Expander>
        </Border>
        <DataGrid x:Name="GridView" Grid.Row="2" MouseDoubleClick="Edit_Click">
            <DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Склад" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="2.5*"/>
                <DataGridTextColumn Header="Заведующий" Binding="{Binding ManagerName}" Width="2*"/><DataGridTextColumn Header="Контакты" Binding="{Binding ManagerContact}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="CountText" Grid.Row="3" Style="{StaticResource CaptionText}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
