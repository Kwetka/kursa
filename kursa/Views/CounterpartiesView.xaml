<UserControl x:Class="kursa.Views.CounterpartiesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="+ Добавить" Style="{StaticResource PrimaryButton}" Click="Add_Click"/><Button Style="{StaticResource BaseButton}" Content="Изменить" Click="Edit_Click"/>
                <Button Content="Удалить" Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="0"/>
            </StackPanel>
            <StackPanel><TextBlock Text="Контрагенты" Style="{StaticResource TitleText}"/><TextBlock Text="Поставщики и покупатели" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal"><TextBlock Text="Поиск" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBox x:Name="SearchBox" Width="310" TextChanged="Search_Changed"/></StackPanel>
        </Border>
        <DataGrid x:Name="GridView" Grid.Row="2" MouseDoubleClick="Edit_Click"><DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/><DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="3*"/>
            <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="2*"/>
        </DataGrid.Columns></DataGrid>
        <TextBlock x:Name="CountText" Grid.Row="3" Style="{StaticResource CaptionText}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
