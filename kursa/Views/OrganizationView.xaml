<UserControl x:Class="kursa.Views.OrganizationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Реквизиты организации" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Администратор заполняет данные грузоотправителя для накладных. Изменения не меняют ранее созданные документы." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,20"/>
            <TextBlock Text="Наименование организации" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" MaxLength="200"/>
            <TextBlock Text="Адрес организации" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><TextBox x:Name="AddressBox" MaxLength="400"/>
            <TextBlock Text="УНП · при наличии" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><TextBox x:Name="UnpBox" MaxLength="30"/>
            <TextBlock Text="Для реализации должны быть заполнены наименование и адрес организации. УНП и прочие реквизиты проверьте для вашего случая." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,14,0,16"/>
            <Button x:Name="SaveButton" Content="Сохранить реквизиты" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Save_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
