<UserControl x:Class="kursa.Views.StocksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button Style="{StaticResource BaseButton}" DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click" HorizontalAlignment="Right" Margin="0"/>
            <Button x:Name="HistoryButton" Style="{StaticResource BaseButton}" DockPanel.Dock="Right" Content="История товара" Click="History_Click" HorizontalAlignment="Right" ToolTip="Все операции по товару выбранной строки (двойной щелчок по строке)"/>
            <StackPanel><TextBlock Text="Текущие остатки" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Остаток сейчас; период отбирает позиции по дате последнего движения" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,0,0,12" Padding="15,12,15,3">
            <Expander x:Name="FiltersExpander" Header="Фильтры" IsExpanded="False">
              <WrapPanel Margin="0,12,0,0">
                <StackPanel Style="{StaticResource FilterField}" Width="215"><TextBlock Text="Движение с · дата / ЧЧ:ММ" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="FromPicker" Width="145"/><TextBox x:Name="FromTimeBox" Width="62" Margin="5,0,0,0" ToolTip="Время ЧЧ:ММ, необязательно"/></StackPanel></StackPanel>
                <StackPanel Style="{StaticResource FilterField}" Width="215"><TextBlock Text="Движение по · дата / ЧЧ:ММ" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="ToPicker" Width="145"/><TextBox x:Name="ToTimeBox" Width="62" Margin="5,0,0,0" ToolTip="Время ЧЧ:ММ, необязательно"/></StackPanel></StackPanel>
                <StackPanel Style="{StaticResource FilterField}" Width="200"><TextBlock Text="Склад" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="WarehouseBox"/></StackPanel>
                <StackPanel Style="{StaticResource FilterField}" Width="200"><TextBlock Text="Товар" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ProductBox"/></StackPanel>
                <StackPanel Style="{StaticResource FilterField}" Width="130"><TextBlock Text="Остаток от" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MinimumBox" KeyDown="Search_KeyDown"/></StackPanel>
                <StackPanel Style="{StaticResource FilterField}" Width="210"><TextBlock Text="Поиск · товар или склад" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SearchBox" KeyDown="Search_KeyDown"/></StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,12,17"><CheckBox x:Name="ZeroBox" Content="Показывать нулевые"/></StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10"><Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/><Button Style="{StaticResource BaseButton}" Content="Сбросить" Click="Reset_Click"/></StackPanel>
              </WrapPanel>
            </Expander>
        </Border>
        <DataGrid x:Name="GridView" Grid.Row="2" HorizontalScrollBarVisibility="Auto" MouseDoubleClick="History_Click">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Склад" Binding="{Binding WarehouseName}" Width="170"/>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="220"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity, StringFormat={}{0:N3}}" Width="110"/>
                <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="70"/>
                <DataGridTextColumn Header="Закупочная цена, BYN" Binding="{Binding PurchasePrice, StringFormat={}{0:N2}}" Width="160"/>
                <DataGridTextColumn Header="Стоимость закупки, BYN" Binding="{Binding PurchaseValue, StringFormat={}{0:N2}}" Width="170"/>
                <DataGridTextColumn Header="Стоимость продажи, BYN" Binding="{Binding SaleValue, StringFormat={}{0:N2}}" Width="170"/>
                <DataGridTextColumn Header="Последнее движение" Binding="{Binding LastMovement, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="CountText" Grid.Row="3" Style="{StaticResource CaptionText}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
