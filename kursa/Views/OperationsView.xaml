<UserControl x:Class="kursa.Views.OperationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="1.4*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ReceiptButton" Content="+ Приход" Style="{StaticResource PrimaryButton}" Click="Receipt_Click"/>
                <Button x:Name="ShipmentButton" Style="{StaticResource BaseButton}" Content="− Реализация" Click="Shipment_Click"/><Button x:Name="TransferButton" Style="{StaticResource BaseButton}" Content="Перемещение" Click="Transfer_Click" Margin="0"/>
            </StackPanel>
            <StackPanel><TextBlock Text="Складские операции" Style="{StaticResource TitleText}"/><TextBlock Text="Нажмите на запись, чтобы увидеть все её товары и накладную" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,0,0,12" Padding="15,12,15,3">
            <Expander x:Name="FiltersExpander" Header="Фильтры" IsExpanded="False">
              <StackPanel Margin="0,12,0,0"><WrapPanel>
                    <StackPanel Style="{StaticResource FilterField}" Width="215"><TextBlock Text="С · дата / ЧЧ:ММ" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="FromPicker" Width="145"/><TextBox x:Name="FromTimeBox" Width="62" Margin="5,0,0,0" ToolTip="Время ЧЧ:ММ, необязательно"/></StackPanel></StackPanel>
                    <StackPanel Style="{StaticResource FilterField}" Width="215"><TextBlock Text="По · дата / ЧЧ:ММ включительно" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="ToPicker" Width="145"/><TextBox x:Name="ToTimeBox" Width="62" Margin="5,0,0,0" ToolTip="Время ЧЧ:ММ, необязательно"/></StackPanel></StackPanel>
                    <StackPanel Style="{StaticResource FilterField}" Width="175"><TextBlock Text="Тип операции" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="KindBox"/></StackPanel>
                    <StackPanel Style="{StaticResource FilterField}" Width="190"><TextBlock Text="Товар" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ProductBox"/></StackPanel>
                    <StackPanel Style="{StaticResource FilterField}" Width="190"><TextBlock Text="Склад · откуда или куда" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="WarehouseBox"/></StackPanel>
                    <StackPanel Style="{StaticResource FilterField}" Width="190"><TextBlock Text="Контрагент" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PartyBox"/></StackPanel>
                    <StackPanel Style="{StaticResource FilterField}" Width="240"><TextBlock Text="Поиск · товар, комментарий, ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SearchBox" KeyDown="Search_KeyDown"/></StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10"><Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/><Button Style="{StaticResource BaseButton}" Content="Сбросить" Click="Reset_Click"/></StackPanel>
              </WrapPanel></StackPanel>
            </Expander>
        </Border>
        <TabControl Grid.Row="2" x:Name="HistoryTabs" SelectionChanged="HistoryTabs_Changed">
            <TabItem Header="Операции целиком">
                <DataGrid x:Name="GridView" HorizontalScrollBarVisibility="Auto" SelectionChanged="Group_Changed"><DataGrid.Columns>
                    <DataGridTextColumn Header="Операция" Binding="{Binding DisplayId}" Width="100"/>
                    <DataGridTextColumn Header="Дата и время" Binding="{Binding OccurredAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="150"/>
                    <DataGridTextColumn Header="Вид" Binding="{Binding KindName}" Width="120"/>
                    <DataGridTextColumn Header="Позиций" Binding="{Binding ItemCount}" Width="85"/>
                    <DataGridTextColumn Header="Со склада" Binding="{Binding FromWarehouse}" Width="140"/><DataGridTextColumn Header="На склад" Binding="{Binding ToWarehouse}" Width="140"/>
                    <DataGridTextColumn Header="Контрагент" Binding="{Binding CounterpartyName}" Width="160"/>
                    <DataGridTextColumn Header="Накладная" Binding="{Binding InvoiceLabel}" Width="135"/>
                    <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="170"/><DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="150"/>
                </DataGrid.Columns></DataGrid>
            </TabItem>
            <TabItem Header="По отдельным товарам">
                <DataGrid x:Name="ProductLinesGrid" HorizontalScrollBarVisibility="Auto" SelectionChanged="Line_Changed"><DataGrid.Columns>
                    <DataGridTextColumn Header="Операция" Binding="{Binding GroupName}" Width="95"/><DataGridTextColumn Header="ID движения" Binding="{Binding Id}" Width="100"/>
                    <DataGridTextColumn Header="Дата и время" Binding="{Binding OccurredAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="150"/>
                    <DataGridTextColumn Header="Вид" Binding="{Binding KindName}" Width="115"/><DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="220"/>
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity, StringFormat={}{0:N3}}" Width="105"/><DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="65"/>
                    <DataGridTextColumn Header="Со склада" Binding="{Binding FromWarehouse}" Width="140"/><DataGridTextColumn Header="На склад" Binding="{Binding ToWarehouse}" Width="140"/>
                    <DataGridTextColumn Header="Контрагент" Binding="{Binding CounterpartyName}" Width="150"/><DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="170"/>
                </DataGrid.Columns></DataGrid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6"><Button x:Name="InvoiceButton" Content="Сохранить накладную DOCX…" Style="{StaticResource BaseButton}" DockPanel.Dock="Right" IsEnabled="False" Click="Invoice_Click" Margin="0"/>
                <TextBlock x:Name="DetailsTitle" Text="Выберите операцию — здесь появятся все её позиции" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <DataGrid x:Name="DetailsGrid" Grid.Row="1" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
                <DataGridTextColumn Header="Товар / услуга" Binding="{Binding Name}" Width="260"/><DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="65"/><DataGridTextColumn Header="Цена, BYN" Binding="{Binding Price}" Width="100"/>
                <DataGridTextColumn Header="Скидка" Binding="{Binding Discount}" Width="80"/><DataGridTextColumn Header="НДС, %" Binding="{Binding Vat}" Width="90"/>
                <DataGridTextColumn Header="С НДС, BYN" Binding="{Binding Total}" Width="115"/><DataGridTextColumn Header="Мест" Binding="{Binding Places}" Width="70"/>
                <DataGridTextColumn Header="Масса, т" Binding="{Binding Mass}" Width="90"/><DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="200"/>
            </DataGrid.Columns></DataGrid>
        </Grid>
        <TextBlock x:Name="CountText" Grid.Row="4" Style="{StaticResource CaptionText}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
