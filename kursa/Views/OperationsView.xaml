<UserControl x:Class="kursa.Views.OperationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ReceiptButton" Content="+ Приход" Style="{StaticResource PrimaryButton}" Click="Receipt_Click"/>
                <Button x:Name="ShipmentButton" Style="{StaticResource BaseButton}" Content="− Реализация" Click="Shipment_Click"/><Button x:Name="TransferButton" Style="{StaticResource BaseButton}" Content="⇄ Перемещение" Click="Transfer_Click"/>
                <Button x:Name="OpenButton" Style="{StaticResource BaseButton}" Content="Позиции документа" Click="Open_Click" ToolTip="Что именно пришло, переместилось или реализовано (двойной щелчок по строке)"/>
                <Button x:Name="PrintButton" Style="{StaticResource BaseButton}" Content="Печать ТТН" Click="Print_Click" Margin="0"/>
            </StackPanel>
            <StackPanel><TextBlock Text="Складские операции" Style="{StaticResource TitleText}"/><TextBlock Text="Журнал документов: операция, склады, время SQL Server · двойной щелчок — позиции документа" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,0,0,12" Padding="15,12,15,3">
            <Expander x:Name="FiltersExpander" Header="Фильтры" IsExpanded="False">
              <StackPanel Margin="0,12,0,0">
                <WrapPanel>
                    <StackPanel Style="{StaticResource FilterField}" Width="215"><TextBlock Text="С · дата / ЧЧ:ММ" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="FromPicker" Width="145"/><TextBox x:Name="FromTimeBox" Width="62" Margin="5,0,0,0" ToolTip="Время ЧЧ:ММ, необязательно"/></StackPanel></StackPanel>
                    <StackPanel Style="{StaticResource FilterField}" Width="215"><TextBlock Text="По · дата / ЧЧ:ММ включительно" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="ToPicker" Width="145"/><TextBox x:Name="ToTimeBox" Width="62" Margin="5,0,0,0" ToolTip="Время ЧЧ:ММ, необязательно"/></StackPanel></StackPanel>
                    <StackPanel Style="{StaticResource FilterField}" Width="175"><TextBlock Text="Тип операции" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="KindBox"/></StackPanel>
                    <StackPanel Style="{StaticResource FilterField}" Width="190"><TextBlock Text="Товар · документы, где он есть" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ProductBox"/></StackPanel>
                    <StackPanel Style="{StaticResource FilterField}" Width="190"><TextBlock Text="Склад · откуда или куда" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="WarehouseBox"/></StackPanel>
                    <StackPanel Style="{StaticResource FilterField}" Width="190"><TextBlock Text="Контрагент" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PartyBox"/></StackPanel>
                    <StackPanel Style="{StaticResource FilterField}" Width="240"><TextBlock Text="Поиск · № ТТН, товар, комментарий, ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SearchBox" KeyDown="Search_KeyDown"/></StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10"><Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/><Button Style="{StaticResource BaseButton}" Content="Сбросить" Click="Reset_Click"/></StackPanel>
                </WrapPanel>
              </StackPanel>
            </Expander>
        </Border>
        <DataGrid x:Name="GridView" Grid.Row="2" HorizontalScrollBarVisibility="Auto" MouseDoubleClick="Open_Click">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата и время" Binding="{Binding OccurredAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="150"/>
                <DataGridTextColumn Header="Операция" Binding="{Binding KindName}" Width="120"/>
                <DataGridTextColumn Header="Со склада" Binding="{Binding FromWarehouse}" Width="170"/>
                <DataGridTextColumn Header="На склад" Binding="{Binding ToWarehouse}" Width="170"/>
                <DataGridTextColumn Header="Документ (№ ТТН)" Binding="{Binding NumberDisplay}" Width="170"/>
                <DataGridTextColumn Header="Контрагент" Binding="{Binding CounterpartyName}" Width="180"/>
                <DataGridTextColumn Header="Позиций" Binding="{Binding LineCount}" Width="75"/>
                <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="160"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="CountText" Grid.Row="3" Style="{StaticResource CaptionText}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
